{
  "code": [
    {"id": "C1", "text": "<!DOCTYPE html>", "source": ["D11"]},
    {"id": "C2", "text": "<html lang=\"en\">", "source": ["D11"]},
    {"id": "C3", "text": "<head>", "source": ["D11"]},
    {"id": "C4", "text": "<meta charset=\"UTF-8\">", "source": ["D11"]},
    {"id": "C5", "text": "<title>Decisions &amp; Code</title>", "source": ["D11"]},
    {"id": "C6", "text": "<style>", "source": ["D11"]},
    {"id": "C7", "text": "* { box-sizing: border-box; margin: 0; padding: 0; }", "source": ["D11"]},
    {"id": "C8", "text": "body { font-family: sans-serif; display: flex; height: 100vh; overflow: hidden; }", "source": ["D5", "D11"]},
    {"id": "C9", "text": "#left, #right { width: 50%; height: 100%; overflow-y: auto; padding: 16px; }", "source": ["D5", "D6", "D7"]},
    {"id": "C10", "text": "#left { border-right: 1px solid #ccc; }", "source": ["D6"]},
    {"id": "C11", "text": ".decision { padding: 8px 10px; margin-bottom: 8px; border-radius: 4px; cursor: pointer; border: 1px solid #ccc; }", "source": ["D10", "D11"]},
    {"id": "C12", "text": ".decision.compiler { background-color: #cc7722; color: #fff; border-color: #a05c10; }", "source": ["D9", "D15"]},
    {"id": "C13", "text": ".decision.human { background-color: #f5f5f5; }", "source": ["D11"]},
    {"id": "C14", "text": ".decision.active { outline: 3px solid #333; }", "source": ["D13", "D14"]},
    {"id": "C15", "text": ".code-line { font-family: monospace; padding: 4px 8px; margin-bottom: 4px; border-radius: 3px; white-space: pre; border: 1px solid transparent; }", "source": ["D16", "D11"]},
    {"id": "C16", "text": ".code-line.highlighted { background-color: #ffe08a; border-color: #e0b030; }", "source": ["D13", "D10"]},
    {"id": "C17", "text": ".decision-id { font-size: 0.75em; opacity: 0.7; margin-right: 6px; }", "source": ["D11"]},
    {"id": "C18", "text": "</style>", "source": ["D11"]},
    {"id": "C19", "text": "</head>", "source": ["D11"]},
    {"id": "C20", "text": "<body>", "source": ["D11"]},
    {"id": "C21", "text": "<div id=\"left\"><h2 style=\"margin-bottom:12px\">Decisions</h2></div>", "source": ["D6", "D11"]},
    {"id": "C22", "text": "<div id=\"right\"><h2 style=\"margin-bottom:12px\">Code</h2></div>", "source": ["D7", "D11"]},
    {"id": "C23", "text": "<script>", "source": ["D11", "D12"]},
    {"id": "C24", "text": "Promise.all([fetch('decisions.json').then(r => r.json()), fetch('code.json').then(r => r.json())])", "source": ["D1", "D12"]},
    {"id": "C25", "text": ".then(([decisionsData, codeData]) => {", "source": ["D12"]},
    {"id": "C26", "text": "  const decisions = decisionsData.decisions;", "source": ["D2"]},
    {"id": "C27", "text": "  const codeLines = codeData.code;", "source": ["D3"]},
    {"id": "C28", "text": "  const left = document.getElementById('left');", "source": ["D6", "D11"]},
    {"id": "C29", "text": "  const right = document.getElementById('right');", "source": ["D7", "D11"]},
    {"id": "C30", "text": "  let activeId = null;", "source": ["D14"]},
    {"id": "C31", "text": "  codeLines.forEach(line => {", "source": ["D4", "D7"]},
    {"id": "C32", "text": "    const div = document.createElement('div');", "source": ["D11"]},
    {"id": "C33", "text": "    div.className = 'code-line';", "source": ["D16"]},
    {"id": "C34", "text": "    div.dataset.source = JSON.stringify(line.source || []);", "source": ["D4"]},
    {"id": "C35", "text": "    div.textContent = line.text;", "source": ["D7"]},
    {"id": "C36", "text": "    right.appendChild(div);", "source": ["D7"]},
    {"id": "C37", "text": "  });", "source": ["D7"]},
    {"id": "C38", "text": "  decisions.forEach(dec => {", "source": ["D6", "D10"]},
    {"id": "C39", "text": "    const div = document.createElement('div');", "source": ["D11"]},
    {"id": "C40", "text": "    const isCompiler = dec.by === 'compiler';", "source": ["D9"]},
    {"id": "C41", "text": "    div.className = 'decision ' + (isCompiler ? 'compiler' : 'human');", "source": ["D9", "D15"]},
    {"id": "C42", "text": "    div.innerHTML = '<span class=\"decision-id\">' + dec.id + '</span>' + dec.text;", "source": ["D6", "D11"]},
    {"id": "C43", "text": "    div.addEventListener('click', () => {", "source": ["D10"]},
    {"id": "C44", "text": "      document.querySelectorAll('.decision.active').forEach(el => el.classList.remove('active'));", "source": ["D13", "D14"]},
    {"id": "C45", "text": "      document.querySelectorAll('.code-line.highlighted').forEach(el => el.classList.remove('highlighted'));", "source": ["D13", "D14"]},
    {"id": "C46", "text": "      if (activeId === dec.id) { activeId = null; return; }", "source": ["D14"]},
    {"id": "C47", "text": "      activeId = dec.id;", "source": ["D10"]},
    {"id": "C48", "text": "      div.classList.add('active');", "source": ["D13"]},
    {"id": "C49", "text": "      document.querySelectorAll('.code-line').forEach(cl => {", "source": ["D10"]},
    {"id": "C50", "text": "        const src = JSON.parse(cl.dataset.source);", "source": ["D4"]},
    {"id": "C51", "text": "        if (src.includes(dec.id)) cl.classList.add('highlighted');", "source": ["D4", "D10", "D13"]},
    {"id": "C52", "text": "      });", "source": ["D10"]},
    {"id": "C53", "text": "    });", "source": ["D10"]},
    {"id": "C54", "text": "    left.appendChild(div);", "source": ["D6"]},
    {"id": "C55", "text": "  });", "source": ["D6"]},
    {"id": "C56", "text": "})", "source": ["D12"]},
    {"id": "C57", "text": ".catch(err => { document.body.innerHTML = '<pre style=\"color:red\">' + err + '</pre>'; });", "source": ["D12"]},
    {"id": "C58", "text": "</script>", "source": ["D11"]},
    {"id": "C59", "text": "</body>", "source": ["D11"]},
    {"id": "C60", "text": "</html>", "source": ["D11"]}
  ]
}
