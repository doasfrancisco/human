root: "insertion sort for 32 2 1"
I1: use insertion sort algorithm  <- "insertion sort"
I2: input list is [32, 2, 1]  <- "32 2 1"
I3: sort in ascending order  (compiler)
I4: print the result  (compiler)
def insertion_sort(arr):  <- I1
    for i in range(1, len(arr)):  <- I1
        key = arr[i]  <- I1
        j = i - 1  <- I1
        while j >= 0 and arr[j] > key:  <- I1, I3
            arr[j + 1] = arr[j]  <- I1
            j -= 1  <- I1
        arr[j + 1] = key  <- I1
    return arr  <- I1
items = [32, 2, 1]  <- I2
print(insertion_sort(items))  <- I1, I4
