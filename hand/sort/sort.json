{
  "ideas": [
    {"id": "I0", "text": "insertion sort for 32 2 1 in ascending order"},
    {"id": "I1", "text": "insertion sort", "source": ["I0"]},
    {"id": "I2", "text": "32 2 1", "source": ["I0"]},
    {"id": "I3", "text": "ascending order", "source": ["I0"]},
    {"id": "I4", "text": "input array is [32, 2, 1]", "source": ["I2"]},
    {"id": "I5", "text": "array length is 3", "source": ["I4"]},
    {"id": "I6", "text": "outer loop starts at index 1 and iterates to end of array", "source": ["I1", "I5"]},
    {"id": "I7", "text": "current element is picked as key at each outer loop iteration", "source": ["I1", "I6"]},
    {"id": "I8", "text": "inner loop compares key with elements to its left", "source": ["I1", "I7"]},
    {"id": "I9", "text": "shift elements greater than key one position to the right", "source": ["I8", "I3"]},
    {"id": "I10", "text": "a left element is greater than key when element > key", "source": ["I3", "I8"]},
    {"id": "I11", "text": "inner loop terminates when index goes below 0 or element is not greater than key", "source": ["I8", "I10"]},
    {"id": "I12", "text": "place key into the position left vacant after shifting", "source": ["I7", "I9", "I11"]},
    {"id": "I13", "text": "first pass: key = 2, compare with 32, shift 32 right, place 2 at index 0, array becomes [2, 32, 1]", "source": ["I6", "I7", "I9", "I12", "I4"]},
    {"id": "I14", "text": "second pass: key = 1, compare with 32 shift right, compare with 2 shift right, place 1 at index 0, array becomes [1, 2, 32]", "source": ["I6", "I7", "I9", "I12", "I13"]},
    {"id": "I15", "text": "output sorted array [1, 2, 32]", "source": ["I14", "I3"]},
    {"id": "I16", "text": "data type for array elements is integer", "source": ["I4"]},
    {"id": "I17", "text": "sorting is performed in-place on the array", "source": ["I1", "I4"]}
  ],
  "code": [
    {"id": "P1", "text": "def insertion_sort(arr):", "source": ["I1", "I17"]},
    {"id": "P2", "text": "    for i in range(1, len(arr)):", "source": ["I6", "I5"]},
    {"id": "P3", "text": "        key = arr[i]", "source": ["I7"]},
    {"id": "P4", "text": "        j = i - 1", "source": ["I8"]},
    {"id": "P5", "text": "        while j >= 0 and arr[j] > key:", "source": ["I10", "I11"]},
    {"id": "P6", "text": "            arr[j + 1] = arr[j]", "source": ["I9"]},
    {"id": "P7", "text": "            j -= 1", "source": ["I11"]},
    {"id": "P8", "text": "        arr[j + 1] = key", "source": ["I12"]},
    {"id": "P9", "text": "    return arr", "source": ["I15", "I17"]},
    {"id": "P10", "text": "arr = [32, 2, 1]", "source": ["I4", "I16"]},
    {"id": "P11", "text": "print(insertion_sort(arr))", "source": ["I15", "I13", "I14"]}
  ]
}
