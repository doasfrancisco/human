  "code": [
    {"line": "from http.server import HTTPServer, BaseHTTPRequestHandler", "sources": ["I2"]},
    {"line": "", "sources": []},
    {"line": "class Handler(BaseHTTPRequestHandler):", "sources": ["I2", "I5"]},
    {"line": "    def do_GET(self):", "sources": ["I5"]},
    {"line": "        self.send_response(200)", "sources": ["I5"]},
