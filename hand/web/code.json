    {"id": "P179", "text": "    allIdeaRows = [];", "source": ["I31"]},
    {"id": "P180", "text": "    allCodeRows = [];", "source": ["I32"]},
    {"id": "P181", "text": "    ideas.forEach(function(idea) {", "source": ["I31"]},
