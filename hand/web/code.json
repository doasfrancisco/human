    {"id": "P198", "text": "    });", "source": ["I31"]},
    {"id": "P199", "text": "    codeLines.forEach(function(line, index) {", "source": ["I32", "I33"]},
    {"id": "P200", "text": "      const row = document.createElement('div');", "source": ["I32"]},
    {"id": "P201", "text": "      row.className = 'code-row';", "source": ["I32"]},
    {"id": "P202", "text": "      row.dataset.id = String(line.id);", "source": ["I34", "I65"]},
