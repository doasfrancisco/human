    {"id": "P60", "text": "<script>", "source": ["I59"]},
    {"id": "P61", "text": "(function() {", "source": ["I59"]},
    {"id": "P62", "text": "  const viewList = document.getElementById('view-list');", "source": ["I30"]},
    {"id": "P63", "text": "  const viewDetail = document.getElementById('view-detail');", "source": ["I30"]},
    {"id": "P64", "text": "  const cardsContainer = document.getElementById('cards-container');", "source": ["I62"]},
    {"id": "P65", "text": "  const colIdeas = document.getElementById('col-ideas');", "source": ["I11"]},
    {"id": "P66", "text": "  const colCode = document.getElementById('col-code');", "source": ["I12"]},
    {"id": "P67", "text": "  const backBtn = document.getElementById('back-btn');", "source": ["I63"]},
    {"id": "P68", "text": "  const projectTitle = document.getElementById('project-title');", "source": ["I30"]},
    {"id": "P69", "text": "  let selectedId = null;", "source": ["I39"]},
    {"id": "P70", "text": "  let allIdeaRows = [];", "source": ["I31", "I35"]},
    {"id": "P71", "text": "  let allCodeRows = [];", "source": ["I32", "I35"]},
    {"id": "P72", "text": "  let sourceMap = {};", "source": ["I35"]},
    {"id": "P73", "text": "  let reverseMap = {};", "source": ["I36"]},
    {"id": "P74", "text": "  let ideaRowEls = {};", "source": ["I34"]},
    {"id": "P75", "text": "  let codeRowEls = {};", "source": ["I34"]},
    {"id": "P76", "text": "  async function init() {", "source": ["I26"]},
    {"id": "P77", "text": "    try {", "source": ["I26"]},
    {"id": "P78", "text": "      const resp = await fetch('./projects.json');", "source": ["I26"]},
    {"id": "P79", "text": "      const data = await resp.json();", "source": ["I26"]},
    {"id": "P80", "text": "      renderProjectList(data.projects);", "source": ["I27"]},
    {"id": "P81", "text": "    } catch(e) {", "source": ["I26"]},
    {"id": "P82", "text": "      cardsContainer.textContent = 'Could not load projects.json: ' + e;", "source": ["I26"]},
    {"id": "P83", "text": "    }", "source": ["I26"]},
    {"id": "P84", "text": "  }", "source": ["I26"]},
    {"id": "P85", "text": "  function renderProjectList(projects) {", "source": ["I27", "I62"]},
    {"id": "P86", "text": "    cardsContainer.innerHTML = '';", "source": ["I27"]},
    {"id": "P87", "text": "    projects.forEach(function(name) {", "source": ["I27"]},
    {"id": "P88", "text": "      const card = document.createElement('div');", "source": ["I27"]},
    {"id": "P89", "text": "      card.className = 'project-card';", "source": ["I27", "I62"]},
    {"id": "P90", "text": "      card.textContent = name;", "source": ["I27"]},
    {"id": "P91", "text": "      card.addEventListener('click', function() { openProject(name); });", "source": ["I10", "I29"]},
    {"id": "P92", "text": "      cardsContainer.appendChild(card);", "source": ["I27"]},
    {"id": "P93", "text": "    });", "source": ["I27"]},
    {"id": "P94", "text": "  }", "source": ["I27"]},
    {"id": "P95", "text": "  async function openProject(name) {", "source": ["I29", "I28"]},
    {"id": "P96", "text": "    try {", "source": ["I28"]},
    {"id": "P97", "text": "      const [ideasResp, codeResp] = await Promise.all([", "source": ["I28"]},
    {"id": "P98", "text": "        fetch('./' + name + '/ideas.json'),", "source": ["I28"]},
    {"id": "P99", "text": "        fetch('./' + name + '/code.json')", "source": ["I28"]},
    {"id": "P100", "text": "      ]);", "source": ["I28"]},
    {"id": "P101", "text": "      const ideasData = await ideasResp.json();", "source": ["I28"]},
    {"id": "P102", "text": "      const codeData = await codeResp.json();", "source": ["I28"]},
    {"id": "P103", "text": "      buildMaps(ideasData.ideas, codeData.code);", "source": ["I35", "I36"]},
    {"id": "P104", "text": "      projectTitle.textContent = name;", "source": ["I30"]},
    {"id": "P105", "text": "      renderDetail(ideasData.ideas, codeData.code);", "source": ["I31", "I32"]},
    {"id": "P106", "text": "      showView('detail');", "source": ["I30"]},
    {"id": "P107", "text": "    } catch(e) {", "source": ["I28"]},
    {"id": "P108", "text": "      alert('Could not load project ' + name + ': ' + e);", "source": ["I28"]},
    {"id": "P109", "text": "    }", "source": ["I28"]},
    {"id": "P110", "text": "  }", "source": ["I29"]},
    {"id": "P111", "text": "  function showView(which) {", "source": ["I30"]},
    {"id": "P112", "text": "    clearSelection();", "source": ["I64"]},
    {"id": "P113", "text": "    if (which === 'list') {", "source": ["I30"]},
    {"id": "P114", "text": "      viewList.style.display = 'block';", "source": ["I30"]},
    {"id": "P115", "text": "      viewDetail.style.display = 'none';", "source": ["I30"]},
    {"id": "P116", "text": "    } else {", "source": ["I30"]},
    {"id": "P117", "text": "      viewList.style.display = 'none';", "source": ["I30"]},
    {"id": "P118", "text": "      viewDetail.style.display = 'flex';", "source": ["I30"]},
    {"id": "P119", "text": "    }", "source": ["I30"]},
    {"id": "P120", "text": "  }", "source": ["I30"]},
    {"id": "P121", "text": "  function buildMaps(ideas, codeLines) {", "source": ["I35", "I36"]},
    {"id": "P122", "text": "    sourceMap = {};", "source": ["I35"]},
    {"id": "P123", "text": "    reverseMap = {};", "source": ["I36"]},
    {"id": "P124", "text": "    const allNodes = ideas.concat(codeLines);", "source": ["I35", "I36"]},
    {"id": "P125", "text": "    allNodes.forEach(function(node) {", "source": ["I35", "I36"]},
    {"id": "P126", "text": "      const id = String(node.id);", "source": ["I65"]},
    {"id": "P127", "text": "      sourceMap[id] = (node.source || []).map(String);", "source": ["I35", "I65", "I66"]},
    {"id": "P128", "text": "      if (!reverseMap[id]) reverseMap[id] = [];", "source": ["I36"]},
    {"id": "P129", "text": "    });", "source": ["I35", "I36"]},
    {"id": "P130", "text": "    allNodes.forEach(function(node) {", "source": ["I36"]},
    {"id": "P131", "text": "      const id = String(node.id);", "source": ["I65"]},
    {"id": "P132", "text": "      (sourceMap[id] || []).forEach(function(srcId) {", "source": ["I36", "I66"]},
    {"id": "P133", "text": "        if (!reverseMap[srcId]) reverseMap[srcId] = [];", "source": ["I36"]},
    {"id": "P134", "text": "        reverseMap[srcId].push(id);", "source": ["I36"]},
    {"id": "P135", "text": "      });", "source": ["I36"]},
    {"id": "P136", "text": "    });", "source": ["I36"]},
    {"id": "P137", "text": "  }", "source": ["I35", "I36"]},
    {"id": "P138", "text": "  function getAncestors(nodeId) {", "source": ["I41"]},
    {"id": "P139", "text": "    const visited = new Set();", "source": ["I67"]},
    {"id": "P140", "text": "    const stack = [nodeId];", "source": ["I41"]},
    {"id": "P141", "text": "    while (stack.length) {", "source": ["I41"]},
    {"id": "P142", "text": "      const cur = stack.pop();", "source": ["I41"]},
    {"id": "P143", "text": "      if (visited.has(cur)) continue;", "source": ["I67"]},
    {"id": "P144", "text": "      visited.add(cur);", "source": ["I67"]},
    {"id": "P145", "text": "      (sourceMap[cur] || []).forEach(function(srcId) {", "source": ["I41", "I66"]},
    {"id": "P146", "text": "        if (srcId !== 'I0' && !visited.has(srcId)) stack.push(srcId);", "source": ["I41", "I67"]},
    {"id": "P147", "text": "      });", "source": ["I41"]},
    {"id": "P148", "text": "    }", "source": ["I41"]},
    {"id": "P149", "text": "    visited.delete(nodeId);", "source": ["I41"]},
    {"id": "P150", "text": "    return visited;", "source": ["I41"]},
    {"id": "P151", "text": "  }", "source": ["I41"]},
    {"id": "P152", "text": "  function getDescendants(nodeId) {", "source": ["I42"]},
    {"id": "P153", "text": "    const visited = new Set();", "source": ["I67"]},
    {"id": "P154", "text": "    const stack = [nodeId];", "source": ["I42"]},
    {"id": "P155", "text": "    while (stack.length) {", "source": ["I42"]},
    {"id": "P156", "text": "      const cur = stack.pop();", "source": ["I42"]},
    {"id": "P157", "text": "      if (visited.has(cur)) continue;", "source": ["I67"]},
    {"id": "P158", "text": "      visited.add(cur);", "source": ["I67"]},
    {"id": "P159", "text": "      (reverseMap[cur] || []).forEach(function(childId) {", "source": ["I42"]},
    {"id": "P160", "text": "        if (!visited.has(childId)) stack.push(childId);", "source": ["I42", "I67"]},
    {"id": "P161", "text": "      });", "source": ["I42"]},
    {"id": "P162", "text": "    }", "source": ["I42"]},
    {"id": "P163", "text": "    visited.delete(nodeId);", "source": ["I42"]},
    {"id": "P164", "text": "    return visited;", "source": ["I42"]},
    {"id": "P165", "text": "  }", "source": ["I42"]},
    {"id": "P166", "text": "  function computeFlow(nodeId) {", "source": ["I40"]},
    {"id": "P167", "text": "    const ancestors = getAncestors(nodeId);", "source": ["I40", "I41"]},
    {"id": "P168", "text": "    const descendants = getDescendants(nodeId);", "source": ["I40", "I42"]},
    {"id": "P169", "text": "    const flow = new Set([nodeId]);", "source": ["I40"]},
    {"id": "P170", "text": "    ancestors.forEach(function(id) { flow.add(id); });", "source": ["I40", "I41"]},
    {"id": "P171", "text": "    descendants.forEach(function(id) { flow.add(id); });", "source": ["I40", "I42"]},
    {"id": "P172", "text": "    return flow;", "source": ["I40"]},
    {"id": "P173", "text": "  }", "source": ["I40"]},
    {"id": "P174", "text": "  function renderDetail(ideas, codeLines) {", "source": ["I31", "I32"]},
    {"id": "P175", "text": "    colIdeas.innerHTML = '';", "source": ["I31"]},
