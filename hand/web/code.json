    {"id": "P46", "text": "<div id=\"view-list\">", "source": ["I30", "I62"]},
    {"id": "P47", "text": "  <h2 style=\"margin-bottom:16px;\">Projects</h2>", "source": ["I62"]},
    {"id": "P48", "text": "  <div id=\"cards-container\"></div>", "source": ["I62"]},
    {"id": "P49", "text": "</div>", "source": ["I30"]},
    {"id": "P50", "text": "<div id=\"view-detail\">", "source": ["I30"]},
    {"id": "P51", "text": "  <div id=\"detail-header\">", "source": ["I63"]},
