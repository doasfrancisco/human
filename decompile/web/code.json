{
  "code": [
    {"id": "C1", "text": "<!doctype html>"},
    {"id": "C2", "text": "<html lang=\"en\">"},
    {"id": "C3", "text": "<head>"},
    {"id": "C4", "text": "<meta charset=\"utf-8\" />"},
    {"id": "C5", "text": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />"},
    {"id": "C6", "text": "<title>decompile \u2014 reader</title>"},
    {"id": "C7", "text": "<style>"},
    {"id": "C8", "text": "  :root{"},
    {"id": "C9", "text": "    --ground:#eef1f4; --surface:#fff; --surface-2:#f6f8fa; --ink:#151a22; --muted:#59636f;"},
    {"id": "C10", "text": "    --faint:#8b95a1; --hair:#dde3e9; --spec:#0e7c86; --spec-wash:rgba(14,124,134,.11);"},
    {"id": "C11", "text": "    --spec-line:rgba(14,124,134,.55); --add:#2f9e44; --move:#a8620d; --gone:#c92a2a;"},
    {"id": "C12", "text": "    --sans:ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;"},
    {"id": "C13", "text": "    --mono:ui-monospace,\"Cascadia Code\",\"SF Mono\",Menlo,Consolas,monospace;"},
    {"id": "C14", "text": "  }"},
    {"id": "C15", "text": "  @media (prefers-color-scheme:dark){:root{"},
    {"id": "C16", "text": "    --ground:#0c0e13; --surface:#14181f; --surface-2:#191e27; --ink:#e7ebf1; --muted:#97a1af;"},
    {"id": "C17", "text": "    --faint:#6c7684; --hair:#262d38; --spec:#3fd0dd; --spec-wash:rgba(63,208,221,.13);"},
    {"id": "C18", "text": "    --spec-line:rgba(63,208,221,.55); --add:#69db7c; --move:#e2a851; --gone:#ff8787; }}"},
    {"id": "C19", "text": "  *{box-sizing:border-box;}"},
    {"id": "C20", "text": "  body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--sans);line-height:1.5;-webkit-font-smoothing:antialiased;}"},
    {"id": "C21", "text": "  .pane{background:var(--surface);border:1px solid var(--hair);border-radius:10px;overflow:hidden;}"},
    {"id": "C22", "text": "  @media (prefers-reduced-motion:reduce){*{transition:none!important;}}"},
    {"id": "C23", "text": "  main{max-width:1500px;margin:0 auto;padding:16px;display:flex;flex-direction:column;gap:14px;min-height:100vh;}"},
    {"id": "C24", "text": "  #cols{display:flex;align-items:flex-start;gap:14px;}"},
    {"id": "C25", "text": "  #left{flex:0 0 44%;min-width:0;display:flex;flex-direction:column;gap:14px;position:sticky;top:16px;}"},
    {"id": "C26", "text": "  #right{flex:1 1 0;min-width:0;}"},
    {"id": "C27", "text": "  #projbar{display:flex;align-items:center;gap:9px;padding:8px 14px;font-size:13px;}"},
    {"id": "C28", "text": "  .caret{color:var(--faint);font-size:15px;line-height:1;cursor:pointer;}"},
    {"id": "C29", "text": "  #projbar #projname{font-family:var(--mono);color:var(--muted);cursor:pointer;flex:1;}"},
    {"id": "C30", "text": "  #ver{font-family:var(--mono);font-size:12px;color:var(--muted);background:var(--surface-2);border:1px solid var(--hair);border-radius:5px;padding:2px 6px;}"},
    {"id": "C31", "text": "  #ideas{padding:8px 0;max-height:calc(100vh - 110px);overflow-y:auto;}"},
    {"id": "C32", "text": "  .irow{display:flex;gap:10px;padding:4px 16px;cursor:pointer;font-size:14px;border-left:3px solid transparent;transition:background .12s;}"},
    {"id": "C33", "text": "  .irow .rid{font-family:var(--mono);font-size:11px;color:var(--spec);flex-shrink:0;min-width:3em;padding-top:2px;}"},
    {"id": "C34", "text": "  .irow.added{border-left-color:var(--add);}"},
    {"id": "C35", "text": "  .irow.moved{border-left-color:var(--move);}"},
    {"id": "C36", "text": "  .irow.gone{border-left-color:var(--gone);cursor:default;color:var(--muted);text-decoration:line-through;opacity:.7;}"},
    {"id": "C37", "text": "  .irow.gone .rid{color:var(--gone);}"},
    {"id": "C38", "text": "  #codefile{font-family:var(--mono);font-size:11px;color:var(--muted);background:var(--surface-2);border-bottom:1px solid var(--hair);padding:5px 16px;}"},
    {"id": "C39", "text": "  #codewrap{padding:10px 0;overflow-x:auto;}"},
    {"id": "C40", "text": "  .crow{display:flex;padding:0 16px;font-family:var(--mono);font-size:13px;line-height:1.62;white-space:pre;cursor:pointer;transition:background .12s;}"},
    {"id": "C41", "text": "  .crow .ln{display:inline-block;width:4ch;margin-right:14px;text-align:right;color:var(--faint);user-select:none;flex-shrink:0;}"},
    {"id": "C42", "text": "  .fold{display:block;width:max-content;background:var(--surface-2);border:1px solid var(--hair);color:var(--faint);font-family:var(--mono);font-size:11px;padding:2px 10px;border-radius:5px;margin:6px 16px;}"},
    {"id": "C43", "text": "  .irow.hov,.crow.hov{background:var(--spec-wash);}"},
    {"id": "C44", "text": "  .irow.flow,.crow.flow{background:var(--spec-wash);}"},
    {"id": "C45", "text": "  .irow.sel,.crow.sel{background:var(--spec-line);color:#fff;}"},
    {"id": "C46", "text": "  .irow.sel .rid,.crow.sel .ln{color:#fff;}"},
    {"id": "C47", "text": "  .irow.sel.selold{background:var(--move);}"},
    {"id": "C48", "text": "  .crow.blank{cursor:default;}"},
    {"id": "C49", "text": "  #graphpane[hidden]{display:none;}"},
    {"id": "C50", "text": "  #gwrap{position:relative;}"},
    {"id": "C51", "text": "  #gcanvas{display:block;width:100%;height:300px;cursor:grab;}"},
    {"id": "C52", "text": "  #gtip{position:absolute;pointer-events:none;background:var(--surface-2);border:1px solid var(--hair);border-radius:6px;padding:4px 8px;font-size:12px;max-width:340px;}"},
    {"id": "C53", "text": "  #gtip[hidden]{display:none;}"},
    {"id": "C54", "text": "  #projects{flex:1 1 0;max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:12px;}"},
    {"id": "C55", "text": "  #projects[hidden]{display:none;}"},
    {"id": "C56", "text": "  .pcard{background:var(--surface);border:1px solid var(--hair);border-radius:10px;padding:14px 18px;cursor:pointer;transition:border-color .12s;}"},
    {"id": "C57", "text": "  .pcard:hover{border-color:var(--spec-line);}"},
    {"id": "C58", "text": "  .pcard .pname{font-weight:600;font-family:var(--mono);}"},
    {"id": "C59", "text": "</style>"},
    {"id": "C60", "text": "</head>"},
    {"id": "C61", "text": "<body>"},
    {"id": "C62", "text": "<main>"},
    {"id": "C63", "text": "  <section class=\"pane\" id=\"graphpane\">"},
    {"id": "C64", "text": "    <div id=\"gwrap\"><canvas id=\"gcanvas\"></canvas><div id=\"gtip\" hidden></div></div>"},
    {"id": "C65", "text": "  </section>"},
    {"id": "C66", "text": "  <div id=\"cols\">"},
    {"id": "C67", "text": "    <div id=\"left\">"},
    {"id": "C68", "text": "      <section class=\"pane\" id=\"projbar\"><span class=\"caret\">\u2039</span><span id=\"projname\"></span><select id=\"ver\"></select></section>"},
    {"id": "C69", "text": "      <section class=\"pane\"><div id=\"ideas\"></div></section>"},
    {"id": "C70", "text": "    </div>"},
    {"id": "C71", "text": "    <div id=\"right\">"},
    {"id": "C72", "text": "      <section class=\"pane\"><div id=\"codefile\"></div><div id=\"codewrap\"><div id=\"code\"></div></div></section>"},
    {"id": "C73", "text": "    </div>"},
    {"id": "C74", "text": "  </div>"},
    {"id": "C75", "text": "  <div id=\"projects\" hidden></div>"},
    {"id": "C76", "text": "</main>"},
    {"id": "C77", "text": "<script>"},
    {"id": "C78", "text": "(function(){"},
    {"id": "C79", "text": "  function esc(s){return s.replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\");}"},
    {"id": "C80", "text": "  var projs=[], proj=null, vers=[], ver=\"latest\";"},
    {"id": "C81", "text": "  var ideas=[], codeLines=[], diff=null, src={}, rev={}, depth={}, sel=null, selOld=false, movedFrom={};"},
    {"id": "C82", "text": "  var pendSel=null, backVer=null;"},
    {"text": ""},
    {"id": "C83", "text": "  fetch(\"projects.json\").then(function(r){return r.json();}).then(function(j){"},
    {"id": "C84", "text": "    projs=j.projects||[];"},
    {"id": "C85", "text": "    if(projs[0]) open(projs[0]);"},
    {"id": "C86", "text": "  }).catch(fail);"},
    {"id": "C87", "text": "  function fail(){document.getElementById(\"code\").textContent=\"could not load \u2014 serve decompile/ and open /web.html\";}"},
    {"text": ""},
    {"id": "C88", "text": "  document.getElementById(\"projbar\").onclick=function(e){"},
    {"id": "C89", "text": "    if(e.target.id!==\"ver\") showProjects();"},
    {"id": "C90", "text": "  };"},
    {"id": "C91", "text": "  document.getElementById(\"ver\").onchange=function(e){"},
    {"id": "C92", "text": "    e.stopPropagation();"},
    {"id": "C93", "text": "    ver=e.target.value;"},
    {"id": "C94", "text": "    backVer=null;"},
    {"id": "C95", "text": "    load();"},
    {"id": "C96", "text": "  };"},
    {"id": "C97", "text": "  document.addEventListener(\"click\",function(e){"},
    {"id": "C98", "text": "    if(!e.target.closest(\".irow,.crow,#projbar,#projects,#gwrap\")) setSel(null);"},
    {"id": "C99", "text": "  });"},
    {"text": ""},
    {"id": "C100", "text": "  function open(name){"},
    {"id": "C101", "text": "    proj=name; ver=\"latest\";"},
    {"id": "C102", "text": "    document.getElementById(\"projname\").textContent=name;"},
    {"id": "C103", "text": "    findVers().then(load);"},
    {"id": "C104", "text": "  }"},
    {"id": "C105", "text": "  function findVers(){"},
    {"id": "C106", "text": "    vers=[];"},
    {"id": "C107", "text": "    function probe(n){"},
    {"id": "C108", "text": "      return fetch(proj+\"/history/\"+n+\"/ideas.json\",{method:\"HEAD\"}).then(function(r){"},
    {"id": "C109", "text": "        if(!r.ok) return;"},
    {"id": "C110", "text": "        vers.push(n);"},
    {"id": "C111", "text": "        return probe(n+1);"},
    {"id": "C112", "text": "      }).catch(function(){});"},
    {"id": "C113", "text": "    }"},
    {"id": "C114", "text": "    return probe(1).then(function(){"},
    {"id": "C115", "text": "      var el=document.getElementById(\"ver\"), html='<option value=\"latest\">latest</option>';"},
    {"id": "C116", "text": "      vers.slice().reverse().forEach(function(n){html+='<option value=\"'+n+'\">v'+n+'</option>';});"},
    {"id": "C117", "text": "      el.innerHTML=html;"},
    {"id": "C118", "text": "      el.value=\"latest\";"},
    {"id": "C119", "text": "    });"},
    {"id": "C120", "text": "  }"},
    {"id": "C121", "text": "  function base(){return proj+\"/\"+(ver===\"latest\"?\"\":\"history/\"+ver+\"/\");}"},
    {"id": "C122", "text": "  function load(){"},
    {"id": "C123", "text": "    sel=null; selOld=false;"},
    {"id": "C124", "text": "    var get=function(f){return fetch(base()+f).then(function(r){return r.ok?r.json():null;}).catch(function(){return null;});};"},
    {"id": "C125", "text": "    Promise.all([get(\"code.json\"),get(\"ideas.json\"),get(\"diff.json\")]).then(function(rs){"},
    {"id": "C126", "text": "      if(!rs[0]||!rs[1]){fail();return;}"},
    {"id": "C127", "text": "      codeLines=rs[0].code; ideas=rs[1].ideas; diff=rs[2];"},
    {"id": "C128", "text": "      movedFrom={};"},
    {"id": "C129", "text": "      if(diff)(diff.moved||[]).forEach(function(m){"},
    {"id": "C130", "text": "        if(typeof m===\"string\") movedFrom[m]=null;"},
    {"id": "C131", "text": "        else movedFrom[m.id]=m.from;"},
    {"id": "C132", "text": "      });"},
    {"id": "C133", "text": "      buildMaps();"},
    {"id": "C134", "text": "      if(pendSel){sel=pendSel; selOld=true; pendSel=null;}"},
    {"id": "C135", "text": "      renderAll();"},
    {"id": "C136", "text": "      initGraph();"},
    {"id": "C137", "text": "    });"},
    {"id": "C138", "text": "  }"},
    {"id": "C139", "text": "  function prevView(id){"},
    {"id": "C140", "text": "    var cur=ver===\"latest\"?vers[vers.length-1]:+ver;"},
    {"id": "C141", "text": "    if(!cur||cur<=1) return;"},
    {"id": "C142", "text": "    if(backVer===null) backVer=ver;"},
    {"id": "C143", "text": "    pendSel=id;"},
    {"id": "C144", "text": "    ver=String(cur-1);"},
    {"id": "C145", "text": "    document.getElementById(\"ver\").value=ver;"},
    {"id": "C146", "text": "    load();"},
    {"id": "C147", "text": "  }"},
    {"id": "C148", "text": "  function showProjects(){"},
    {"id": "C149", "text": "    document.getElementById(\"cols\").style.display=\"none\";"},
    {"id": "C150", "text": "    document.getElementById(\"graphpane\").hidden=true;"},
    {"id": "C151", "text": "    var el=document.getElementById(\"projects\");"},
    {"id": "C152", "text": "    el.hidden=false;"},
    {"id": "C153", "text": "    el.innerHTML=projs.map(function(p){return '<div class=\"pcard\"><div class=\"pname\">'+esc(p)+'</div></div>';}).join(\"\");"},
    {"id": "C154", "text": "    Array.prototype.forEach.call(el.querySelectorAll(\".pcard\"),function(c,i){"},
    {"id": "C155", "text": "      c.onclick=function(){"},
    {"id": "C156", "text": "        el.hidden=true;"},
    {"id": "C157", "text": "        document.getElementById(\"cols\").style.display=\"\";"},
    {"id": "C158", "text": "        document.getElementById(\"graphpane\").hidden=false;"},
    {"id": "C159", "text": "        open(projs[i]);"},
    {"id": "C160", "text": "      };"},
    {"id": "C161", "text": "    });"},
    {"id": "C162", "text": "  }"},
    {"text": ""},
    {"id": "C163", "text": "  function buildMaps(){"},
    {"id": "C164", "text": "    src={}; rev={}; depth={};"},
    {"id": "C165", "text": "    codeLines.forEach(function(c){if(!c.id)return; src[c.id]=[]; rev[c.id]=[]; depth[c.id]=0;});"},
    {"id": "C166", "text": "    ideas.forEach(function(n){src[n.id]=(n.source||[]).slice(); rev[n.id]=rev[n.id]||[];});"},
    {"id": "C167", "text": "    ideas.forEach(function(n){"},
    {"id": "C168", "text": "      src[n.id].forEach(function(s){(rev[s]=rev[s]||[]).push(n.id);});"},
    {"id": "C169", "text": "    });"},
    {"id": "C170", "text": "    var todo=ideas.slice();"},
    {"id": "C171", "text": "    while(todo.length){"},
    {"id": "C172", "text": "      var rest=todo.filter(function(n){"},
    {"id": "C173", "text": "        if(!src[n.id].every(function(s){return depth[s]!==undefined;})) return true;"},
    {"id": "C174", "text": "        depth[n.id]=1+Math.max.apply(null,src[n.id].map(function(s){return depth[s];}));"},
    {"id": "C175", "text": "        return false;"},
    {"id": "C176", "text": "      });"},
    {"id": "C177", "text": "      if(rest.length===todo.length){rest.forEach(function(n){depth[n.id]=1;});break;}"},
    {"id": "C178", "text": "      todo=rest;"},
    {"id": "C179", "text": "    }"},
    {"id": "C180", "text": "  }"},
    {"id": "C181", "text": "  function walk(id,map){"},
    {"id": "C182", "text": "    var seen={}, stack=[id];"},
    {"id": "C183", "text": "    while(stack.length){"},
    {"id": "C184", "text": "      var cur=stack.pop();"},
    {"id": "C185", "text": "      if(seen[cur]) continue;"},
    {"id": "C186", "text": "      seen[cur]=1;"},
    {"id": "C187", "text": "      (map[cur]||[]).forEach(function(n){stack.push(n);});"},
    {"id": "C188", "text": "    }"},
    {"id": "C189", "text": "    return seen;"},
    {"id": "C190", "text": "  }"},
    {"id": "C191", "text": "  function flowOf(id){"},
    {"id": "C192", "text": "    var f=walk(id,src), d=walk(id,rev), k;"},
    {"id": "C193", "text": "    for(k in d) f[k]=1;"},
    {"id": "C194", "text": "    return f;"},
    {"id": "C195", "text": "  }"},
    {"text": ""},
    {"id": "C196", "text": "  function mark(id){"},
    {"id": "C197", "text": "    if(!diff) return \"\";"},
    {"id": "C198", "text": "    if(diff.added.indexOf(id)>=0) return \" added\";"},
    {"id": "C199", "text": "    if(id in movedFrom) return \" moved\";"},
    {"id": "C200", "text": "    return \"\";"},
    {"id": "C201", "text": "  }"},
    {"id": "C202", "text": "  function renderIdeas(flow){"},
    {"id": "C203", "text": "    var el=document.getElementById(\"ideas\");"},
    {"id": "C204", "text": "    var rows=ideas.slice().sort(function(a,b){return depth[b.id]-depth[a.id];});"},
    {"id": "C205", "text": "    var html=\"\", hidden=0;"},
    {"id": "C206", "text": "    function pill(){if(hidden){html+='<span class=\"fold\">\u22ef '+hidden+' hidden</span>';hidden=0;}}"},
    {"id": "C207", "text": "    rows.forEach(function(n){"},
    {"id": "C208", "text": "      if(flow&&!flow[n.id]){hidden++;return;}"},
    {"id": "C209", "text": "      pill();"},
    {"id": "C210", "text": "      html+='<div class=\"irow'+mark(n.id)+(flow?(n.id===sel?(selOld?\" sel selold\":\" sel\"):\" flow\"):\"\")+'\" data-id=\"'+n.id+'\">'"},
    {"id": "C211", "text": "        +'<span class=\"rid\">'+n.id+'</span><span>'+esc(n.text)+'</span></div>';"},
    {"id": "C212", "text": "    });"},
    {"id": "C213", "text": "    pill();"},
    {"id": "C214", "text": "    if(diff&&diff.removed.length&&!flow){"},
    {"id": "C215", "text": "      diff.removed.forEach(function(n){"},
    {"id": "C216", "text": "        html+='<div class=\"irow gone\"><span class=\"rid\">'+n.id+'</span><span>'+esc(n.text)+'</span></div>';"},
    {"id": "C217", "text": "      });"},
    {"id": "C218", "text": "    }"},
    {"id": "C219", "text": "    el.innerHTML=html;"},
    {"id": "C220", "text": "    wire(el,\".irow\");"},
    {"id": "C221", "text": "  }"},
    {"id": "C222", "text": "  function renderCode(flow){"},
    {"id": "C223", "text": "    var el=document.getElementById(\"code\");"},
    {"id": "C224", "text": "    var html=\"\", hidden=0;"},
    {"id": "C225", "text": "    function pill(){if(hidden){html+='<span class=\"fold\">\u22ef '+hidden+' lines</span>';hidden=0;}}"},
    {"id": "C226", "text": "    codeLines.forEach(function(c,i){"},
    {"id": "C227", "text": "      if(!c.id){"},
    {"id": "C228", "text": "        if(flow){hidden++;return;}"},
    {"id": "C229", "text": "        pill();"},
    {"id": "C230", "text": "        html+='<div class=\"crow blank\"><span class=\"ln\">'+(i+1)+'</span><span>'+(esc(c.text)||\" \")+'</span></div>';"},
    {"id": "C231", "text": "        return;"},
    {"id": "C232", "text": "      }"},
    {"id": "C233", "text": "      if(flow&&!flow[c.id]){hidden++;return;}"},
    {"id": "C234", "text": "      pill();"},
    {"id": "C235", "text": "      html+='<div class=\"crow'+(flow?(c.id===sel?\" sel\":\" flow\"):\"\")+'\" data-id=\"'+c.id+'\">'"},
    {"id": "C236", "text": "        +'<span class=\"ln\">'+(i+1)+'</span><span>'+esc(c.text)+'</span></div>';"},
    {"id": "C237", "text": "    });"},
    {"id": "C238", "text": "    pill();"},
    {"id": "C239", "text": "    el.innerHTML=html;"},
    {"id": "C240", "text": "    wire(el,\".crow\");"},
    {"id": "C241", "text": "  }"},
    {"id": "C242", "text": "  function wire(el,q){"},
    {"id": "C243", "text": "    Array.prototype.forEach.call(el.querySelectorAll(q),function(row){"},
    {"id": "C244", "text": "      var id=row.getAttribute(\"data-id\");"},
    {"id": "C245", "text": "      if(!id) return;"},
    {"id": "C246", "text": "      row.onclick=function(e){e.stopPropagation();setSel(id,false);};"},
    {"id": "C247", "text": "      row.oncontextmenu=function(e){"},
    {"id": "C248", "text": "        if(!(id in movedFrom)) return;"},
    {"id": "C249", "text": "        e.preventDefault(); e.stopPropagation();"},
    {"id": "C250", "text": "        prevView(id);"},
    {"id": "C251", "text": "      };"},
    {"id": "C252", "text": "      row.onmouseenter=function(){if(sel)return;hov(flowOf(id));};"},
    {"id": "C253", "text": "      row.onmouseleave=function(){if(sel)return;hov(null);};"},
    {"id": "C254", "text": "    });"},
    {"id": "C255", "text": "  }"},
    {"id": "C256", "text": "  function hov(flow){"},
    {"id": "C257", "text": "    Array.prototype.forEach.call(document.querySelectorAll(\".irow,.crow\"),function(row){"},
    {"id": "C258", "text": "      var id=row.getAttribute(\"data-id\");"},
    {"id": "C259", "text": "      row.classList.toggle(\"hov\",!!(flow&&id&&flow[id]));"},
    {"id": "C260", "text": "    });"},
    {"id": "C261", "text": "    G.flowHov=flow;"},
    {"id": "C262", "text": "    if(G.ctx) drawGraph();"},
    {"id": "C263", "text": "  }"},
    {"id": "C264", "text": "  function setSel(id,old){"},
    {"id": "C265", "text": "    if(id===null||(sel===id&&selOld===!!old)){"},
    {"id": "C266", "text": "      sel=null; selOld=false;"},
    {"id": "C267", "text": "      if(backVer!==null){"},
    {"id": "C268", "text": "        ver=backVer; backVer=null;"},
    {"id": "C269", "text": "        document.getElementById(\"ver\").value=ver;"},
    {"id": "C270", "text": "        load(); return;"},
    {"id": "C271", "text": "      }"},
    {"id": "C272", "text": "    }else{sel=id;selOld=!!old;}"},
    {"id": "C273", "text": "    G.flowHov=null;"},
    {"id": "C274", "text": "    renderAll();"},
    {"id": "C275", "text": "  }"},
    {"id": "C276", "text": "  function renderAll(){"},
    {"id": "C277", "text": "    var flow=sel?flowOf(sel):null;"},
    {"id": "C278", "text": "    document.getElementById(\"codefile\").textContent=proj+(ver===\"latest\"?\"\":\"  \u00b7  v\"+ver)"},
    {"id": "C279", "text": "      +(sel&&selOld?\"  \u00b7  previous mapping of \"+sel:\"\");"},
    {"id": "C280", "text": "    renderIdeas(flow);"},
    {"id": "C281", "text": "    renderCode(flow);"},
    {"id": "C282", "text": "    G.flowSel=flow;"},
    {"id": "C283", "text": "    if(G.ctx) drawGraph();"},
    {"id": "C284", "text": "  }"},
    {"text": ""},
    {"id": "C285", "text": "  var G={nodes:[],edges:[],scale:1,ox:0,oy:0,hov:null,wired:false};"},
    {"id": "C286", "text": "  function cssVar(name){return getComputedStyle(document.documentElement).getPropertyValue(name).trim();}"},
    {"id": "C287", "text": "  function initGraph(){"},
    {"id": "C288", "text": "    var layers={}, maxd=1;"},
    {"id": "C289", "text": "    ideas.forEach(function(n){var d=depth[n.id]||1; maxd=Math.max(maxd,d); (layers[d]=layers[d]||[]).push(n);});"},
    {"id": "C290", "text": "    var gapX=160, gapY=120;"},
    {"id": "C291", "text": "    G.nodes=[]; G.byId={}; G.maxKids=1;"},
    {"id": "C292", "text": "    Object.keys(layers).forEach(function(d){"},
    {"id": "C293", "text": "      layers[d].forEach(function(n,i){"},
    {"id": "C294", "text": "        var kids=(src[n.id]||[]).filter(function(s){return depth[s]>0;}).length;"},
    {"id": "C295", "text": "        G.maxKids=Math.max(G.maxKids,kids);"},
    {"id": "C296", "text": "        var node={id:n.id,text:n.text,kids:kids,gone:false,"},
    {"id": "C297", "text": "                  x:(i-(layers[d].length-1)/2)*gapX,y:(maxd-d)*gapY};"},
    {"id": "C298", "text": "        G.nodes.push(node); G.byId[n.id]=node;"},
    {"id": "C299", "text": "      });"},
    {"id": "C300", "text": "    });"},
    {"id": "C301", "text": "    var gone=(diff&&diff.removed)||[];"},
    {"id": "C302", "text": "    gone.forEach(function(n,i){"},
    {"id": "C303", "text": "      var node={id:n.id,text:n.text,kids:0,gone:true,x:(i-(gone.length-1)/2)*gapX,y:maxd*gapY};"},
    {"id": "C304", "text": "      G.nodes.push(node); G.byId[n.id]=node;"},
    {"id": "C305", "text": "    });"},
    {"id": "C306", "text": "    G.edges=[];"},
    {"id": "C307", "text": "    ideas.forEach(function(n){"},
    {"id": "C308", "text": "      (n.source||[]).forEach(function(s){if(G.byId[s])G.edges.push([n.id,s]);});"},
    {"id": "C309", "text": "    });"},
    {"id": "C310", "text": "    G.col={hair:cssVar(\"--hair\"),ink:cssVar(\"--ink\"),faint:cssVar(\"--faint\"),ground:cssVar(\"--ground\"),"},
    {"id": "C311", "text": "           add:cssVar(\"--add\"),move:cssVar(\"--move\"),gone:cssVar(\"--gone\"),spec:cssVar(\"--spec\")};"},
    {"id": "C312", "text": "    var cv=document.getElementById(\"gcanvas\"), dpr=window.devicePixelRatio||1;"},
    {"id": "C313", "text": "    cv.width=cv.clientWidth*dpr; cv.height=cv.clientHeight*dpr;"},
    {"id": "C314", "text": "    G.cv=cv; G.ctx=cv.getContext(\"2d\"); G.dpr=dpr;"},
    {"id": "C315", "text": "    var xs=G.nodes.map(function(n){return n.x;}), ys=G.nodes.map(function(n){return n.y;});"},
    {"id": "C316", "text": "    var w=Math.max.apply(null,xs)-Math.min.apply(null,xs)+gapX*2;"},
    {"id": "C317", "text": "    var h=Math.max.apply(null,ys)-Math.min.apply(null,ys)+gapY*2;"},
    {"id": "C318", "text": "    G.scale=Math.min(cv.clientWidth/w,cv.clientHeight/h,1.4);"},
    {"id": "C319", "text": "    G.ox=cv.clientWidth/2-(Math.max.apply(null,xs)+Math.min.apply(null,xs))/2*G.scale;"},
    {"id": "C320", "text": "    G.oy=cv.clientHeight/2-(Math.max.apply(null,ys)+Math.min.apply(null,ys))/2*G.scale;"},
    {"id": "C321", "text": "    if(!G.wired){wireGraph();G.wired=true;}"},
    {"id": "C322", "text": "    drawGraph();"},
    {"id": "C323", "text": "  }"},
    {"id": "C324", "text": "  function nodeColor(n){"},
    {"id": "C325", "text": "    if(n.gone) return \"transparent\";"},
    {"id": "C326", "text": "    var t=G.maxKids?n.kids/G.maxKids:0, u;"},
    {"id": "C327", "text": "    if(t<0.5){u=t*2; return \"hsl(30,\"+Math.round(75*(1-u))+\"%,55%)\";}"},
    {"id": "C328", "text": "    u=(t-0.5)*2;"},
    {"id": "C329", "text": "    return \"hsl(135,\"+Math.round(55*u)+\"%,\"+Math.round(55-7*u)+\"%)\";"},
    {"id": "C330", "text": "  }"},
    {"id": "C331", "text": "  function drawGraph(){"},
    {"id": "C332", "text": "    var ctx=G.ctx, cv=G.cv, dpr=G.dpr;"},
    {"id": "C333", "text": "    ctx.setTransform(dpr,0,0,dpr,0,0);"},
    {"id": "C334", "text": "    ctx.clearRect(0,0,cv.clientWidth,cv.clientHeight);"},
    {"id": "C335", "text": "    ctx.setTransform(dpr*G.scale,0,0,dpr*G.scale,dpr*G.ox,dpr*G.oy);"},
    {"id": "C336", "text": "    var fl=G.flowHov||G.flowSel;"},
    {"id": "C337", "text": "    ctx.strokeStyle=G.col.hair; ctx.lineWidth=1.4;"},
    {"id": "C338", "text": "    G.edges.forEach(function(e){"},
    {"id": "C339", "text": "      var a=G.byId[e[0]], b=G.byId[e[1]];"},
    {"id": "C340", "text": "      ctx.globalAlpha=fl&&!(fl[a.id]&&fl[b.id])?0.12:1;"},
    {"id": "C341", "text": "      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();"},
    {"id": "C342", "text": "    });"},
    {"id": "C343", "text": "    G.nodes.forEach(function(n){"},
    {"id": "C344", "text": "      var r=16;"},
    {"id": "C345", "text": "      ctx.globalAlpha=fl&&!fl[n.id]?0.15:1;"},
    {"id": "C346", "text": "      ctx.beginPath(); ctx.arc(n.x,n.y,r,0,Math.PI*2);"},
    {"id": "C347", "text": "      ctx.fillStyle=nodeColor(n); ctx.fill();"},
    {"id": "C348", "text": "      var m=n.gone?\"gone\":mark(n.id).trim();"},
    {"id": "C349", "text": "      ctx.lineWidth=(n.id===sel||m)?3.5:1.4;"},
    {"id": "C350", "text": "      ctx.strokeStyle=n.id===sel?(selOld?G.col.move:G.col.spec):"},
    {"id": "C351", "text": "        m===\"added\"?G.col.add:m===\"moved\"?G.col.move:m===\"gone\"?G.col.gone:"},
    {"id": "C352", "text": "        (G.hov===n.id?G.col.spec:G.col.hair);"},
    {"id": "C353", "text": "      if(n.gone) ctx.setLineDash([4,3]);"},
    {"id": "C354", "text": "      ctx.stroke(); ctx.setLineDash([]);"},
    {"id": "C355", "text": "      ctx.fillStyle=n.gone?G.col.gone:\"#fff\";"},
    {"id": "C356", "text": "      ctx.font=\"600 10px \"+cssVar(\"--mono\");"},
    {"id": "C357", "text": "      ctx.textAlign=\"center\"; ctx.textBaseline=\"middle\";"},
    {"id": "C358", "text": "      ctx.fillText(n.id,n.x,n.y);"},
    {"id": "C359", "text": "      ctx.fillStyle=G.col.faint; ctx.font=\"9px \"+cssVar(\"--sans\");"},
    {"id": "C360", "text": "      var t=n.text.length>26?n.text.slice(0,25)+\"\u2026\":n.text;"},
    {"id": "C361", "text": "      ctx.fillText(t,n.x,n.y+r+11);"},
    {"id": "C362", "text": "    });"},
    {"id": "C363", "text": "    ctx.globalAlpha=1;"},
    {"id": "C364", "text": "  }"},
    {"id": "C365", "text": "  function graphHit(mx,my){"},
    {"id": "C366", "text": "    var wx=(mx-G.ox)/G.scale, wy=(my-G.oy)/G.scale, hit=null;"},
    {"id": "C367", "text": "    G.nodes.forEach(function(n){"},
    {"id": "C368", "text": "      if((wx-n.x)*(wx-n.x)+(wy-n.y)*(wy-n.y)<=18*18) hit=n;"},
    {"id": "C369", "text": "    });"},
    {"id": "C370", "text": "    return hit;"},
    {"id": "C371", "text": "  }"},
    {"id": "C372", "text": "  function wireGraph(){"},
    {"id": "C373", "text": "    var cv=G.cv, tip=document.getElementById(\"gtip\"), drag=null;"},
    {"id": "C374", "text": "    cv.addEventListener(\"wheel\",function(e){"},
    {"id": "C375", "text": "      e.preventDefault();"},
    {"id": "C376", "text": "      var b=cv.getBoundingClientRect(), mx=e.clientX-b.left, my=e.clientY-b.top;"},
    {"id": "C377", "text": "      var f=e.deltaY<0?1.12:1/1.12;"},
    {"id": "C378", "text": "      G.scale*=f;"},
    {"id": "C379", "text": "      G.ox=mx-(mx-G.ox)*f; G.oy=my-(my-G.oy)*f;"},
    {"id": "C380", "text": "      drawGraph();"},
    {"id": "C381", "text": "    },{passive:false});"},
    {"id": "C382", "text": "    cv.onmousedown=function(e){"},
    {"id": "C383", "text": "      if(e.button!==0) return;"},
    {"id": "C384", "text": "      var b=cv.getBoundingClientRect();"},
    {"id": "C385", "text": "      drag={x:e.clientX,y:e.clientY,node:graphHit(e.clientX-b.left,e.clientY-b.top),moved:false};"},
    {"id": "C386", "text": "      cv.style.cursor=\"grabbing\";"},
    {"id": "C387", "text": "    };"},
    {"id": "C388", "text": "    window.addEventListener(\"mouseup\",function(){"},
    {"id": "C389", "text": "      if(drag&&!drag.moved&&drag.node&&!drag.node.gone) setSel(drag.node.id,false);"},
    {"id": "C390", "text": "      drag=null; cv.style.cursor=\"grab\";"},
    {"id": "C391", "text": "    });"},
    {"id": "C392", "text": "    cv.oncontextmenu=function(e){"},
    {"id": "C393", "text": "      var b=cv.getBoundingClientRect(), hit=graphHit(e.clientX-b.left,e.clientY-b.top);"},
    {"id": "C394", "text": "      if(!hit||!(hit.id in movedFrom)) return;"},
    {"id": "C395", "text": "      e.preventDefault();"},
    {"id": "C396", "text": "      prevView(hit.id);"},
    {"id": "C397", "text": "    };"},
    {"id": "C398", "text": "    cv.onmousemove=function(e){"},
    {"id": "C399", "text": "      var b=cv.getBoundingClientRect(), mx=e.clientX-b.left, my=e.clientY-b.top;"},
    {"id": "C400", "text": "      if(drag){"},
    {"id": "C401", "text": "        var dx=e.clientX-drag.x, dy=e.clientY-drag.y;"},
    {"id": "C402", "text": "        if(Math.abs(dx)+Math.abs(dy)>2) drag.moved=true;"},
    {"id": "C403", "text": "        if(drag.node){drag.node.x+=dx/G.scale; drag.node.y+=dy/G.scale;}"},
    {"id": "C404", "text": "        else{G.ox+=dx; G.oy+=dy;}"},
    {"id": "C405", "text": "        drag.x=e.clientX; drag.y=e.clientY;"},
    {"id": "C406", "text": "        drawGraph(); return;"},
    {"id": "C407", "text": "      }"},
    {"id": "C408", "text": "      var hit=graphHit(mx,my);"},
    {"id": "C409", "text": "      G.hov=hit?hit.id:null;"},
    {"id": "C410", "text": "      if(hit){"},
    {"id": "C411", "text": "        var extra=hit.gone?\" \u2014 removed\":"},
    {"id": "C412", "text": "          diff&&diff.added.indexOf(hit.id)>=0?\" \u2014 added\":"},
    {"id": "C413", "text": "          movedFrom[hit.id]?\" \u2014 moved, was: \"+movedFrom[hit.id].join(\", \"):"},
    {"id": "C414", "text": "          (hit.id in movedFrom)?\" \u2014 moved\":\"\";"},
    {"id": "C415", "text": "        tip.textContent=hit.text+\" \u2014 \"+hit.kids+\" children\"+extra;"},
    {"id": "C416", "text": "        tip.style.left=(mx+14)+\"px\"; tip.style.top=(my+14)+\"px\";"},
    {"id": "C417", "text": "        tip.hidden=false;"},
    {"id": "C418", "text": "      }else tip.hidden=true;"},
    {"id": "C419", "text": "      if(!sel) hov(hit&&!hit.gone?flowOf(hit.id):null);"},
    {"id": "C420", "text": "      else drawGraph();"},
    {"id": "C421", "text": "    };"},
    {"id": "C422", "text": "    cv.onmouseleave=function(){"},
    {"id": "C423", "text": "      G.hov=null; tip.hidden=true;"},
    {"id": "C424", "text": "      if(!sel) hov(null); else drawGraph();"},
    {"id": "C425", "text": "    };"},
    {"id": "C426", "text": "  }"},
    {"id": "C427", "text": "})();"},
    {"id": "C428", "text": "</script>"},
    {"id": "C429", "text": "</body>"},
    {"id": "C430", "text": "</html>"}
  ]
}
