{
  "code": [
    {"id": "C1", "text": "import difflib"},
    {"id": "C2", "text": "import json"},
    {"id": "C3", "text": "import os"},
    {"id": "C4", "text": "import sys"},
    {"id": "C5", "text": "from pathlib import Path"},
    {"text": ""},
    {"id": "C6", "text": "import boto3"},
    {"id": "C7", "text": "from botocore.config import Config"},
    {"id": "C8", "text": "from dotenv import load_dotenv"},
    {"text": ""},
    {"id": "C9", "text": "load_dotenv(Path(__file__).parent / \".env\")"},
    {"text": ""},
    {"id": "C10", "text": "IDEAS_PROMPT = \"\"\"You are a decompiler. The input is code, one line per id. Understand the program, then extract the ideas behind it, layer by layer."},
    {"text": ""},
    {"id": "C11", "text": "Code lines:"},
    {"id": "C12", "text": "{code}"},
    {"text": ""},
    {"id": "C13", "text": "Rules:"},
    {"id": "C14", "text": "1. An idea is a decision the programmer made. A different decision would give different code."},
    {"id": "C15", "text": "2. Work bottom-up. First write the low ideas straight from the code; their sources are code line ids."},
    {"id": "C16", "text": "3. Then abstract. When lower ideas are together one simpler decision, add a higher idea whose source is those idea ids. Keep folding until no idea can be made simpler."},
    {"id": "C17", "text": "4. The top ideas alone must say what the program is, in the fewest and simplest words. All the detail stays reachable below them."},
    {"id": "C18", "text": "5. Idea text is short: a compressed phrase, not a sentence. It may name identifiers from the code, but never copies a code line."},
    {"id": "C19", "text": "6. Every code line id must appear in the source of at least one idea."},
    {"id": "C20", "text": "7. Every idea has a non-empty source."},
    {"id": "C21", "text": "8. When the code behind an idea calls or reads what an other idea decides, that other idea's id also goes into the source."},
    {"id": "C22", "text": "{old}"},
    {"id": "C23", "text": "Return one JSON object only, no code fences:"},
    {"id": "C24", "text": "{{\"ideas\": [{{\"id\": \"I1\", \"text\": \"ascending order\", \"source\": [\"C5\"]}}]}}\"\"\""},
    {"text": ""},
    {"id": "C25", "text": "OLD_RULES = \"\"\""},
    {"id": "C26", "text": "Ideas from an earlier version of this code:"},
    {"id": "C27", "text": "{ideas}"},
    {"text": ""},
    {"id": "C28", "text": "9. If an earlier idea is still true, keep its id. Reword its text only to satisfy rule 5; the meaning must not change."},
    {"id": "C29", "text": "10. If an earlier idea is no longer true, drop it."},
    {"id": "C30", "text": "11. A new idea gets an id no earlier idea used."},
    {"id": "C31", "text": "\"\"\""},
    {"text": ""},
    {"text": ""},
    {"id": "C32", "text": "def ask(prompt):"},
    {"id": "C33", "text": "    client = boto3.client("},
    {"id": "C34", "text": "        \"bedrock-runtime\","},
    {"id": "C35", "text": "        region_name=os.environ[\"AWS_REGION\"],"},
    {"id": "C36", "text": "        config=Config(connect_timeout=10, read_timeout=600),"},
    {"id": "C37", "text": "    )"},
    {"id": "C38", "text": "    r = client.converse("},
    {"id": "C39", "text": "        modelId=os.environ[\"BEDROCK_MODEL_ID\"],"},
    {"id": "C40", "text": "        messages=[{\"role\": \"user\", \"content\": [{\"text\": prompt}]}],"},
    {"id": "C41", "text": "        inferenceConfig={\"maxTokens\": 32000},"},
    {"id": "C42", "text": "    )"},
    {"id": "C43", "text": "    assert r[\"stopReason\"] == \"end_turn\", f'reply was cut: {r[\"stopReason\"]}'"},
    {"id": "C44", "text": "    raw = r[\"output\"][\"message\"][\"content\"][0][\"text\"]"},
    {"id": "C45", "text": "    return json.loads(raw[raw.index(\"{\"):raw.rindex(\"}\") + 1])"},
    {"text": ""},
    {"text": ""},
    {"id": "C46", "text": "def write_json(path, key, rows):"},
    {"id": "C47", "text": "    body = \",\\n    \".join(json.dumps(r) for r in rows)"},
    {"id": "C48", "text": "    path.write_text(f'{{\\n  \"{key}\": [\\n    {body}\\n  ]\\n}}\\n', encoding=\"utf-8\")"},
    {"text": ""},
    {"text": ""},
    {"id": "C49", "text": "def load(path, key):"},
    {"id": "C50", "text": "    return json.loads(path.read_text(encoding=\"utf-8\"))[key] if path.exists() else None"},
    {"text": ""},
    {"text": ""},
    {"id": "C51", "text": "def snapshot(folder):"},
    {"id": "C52", "text": "    hist = folder / \"history\""},
    {"id": "C53", "text": "    hist.mkdir(exist_ok=True)"},
    {"id": "C54", "text": "    v = hist / str(len(list(hist.iterdir())) + 1)"},
    {"id": "C55", "text": "    v.mkdir()"},
    {"id": "C56", "text": "    for name in (\"code.json\", \"ideas.json\", \"diff.json\"):"},
    {"id": "C57", "text": "        if (folder / name).exists():"},
    {"id": "C58", "text": "            (v / name).write_bytes((folder / name).read_bytes())"},
    {"id": "C59", "text": "    return v"},
    {"text": ""},
    {"text": ""},
    {"id": "C60", "text": "def check(code, ideas):"},
    {"id": "C61", "text": "    code_ids = {c[\"id\"] for c in code}"},
    {"id": "C62", "text": "    by_id = {i[\"id\"]: i for i in ideas}"},
    {"id": "C63", "text": "    assert len(by_id) == len(ideas), \"duplicate idea id\""},
    {"id": "C64", "text": "    assert not code_ids & by_id.keys(), \"idea id collides with a code id\""},
    {"id": "C65", "text": "    for i in ideas:"},
    {"id": "C66", "text": "        assert i.get(\"source\"), f'{i[\"id\"]}: an idea needs a source'"},
    {"id": "C67", "text": "        assert set(i[\"source\"]) <= (code_ids | by_id.keys()) - {i[\"id\"]}, f'{i[\"id\"]}: unknown source'"},
    {"id": "C68", "text": "    used = {s for i in ideas for s in i[\"source\"]}"},
    {"id": "C69", "text": "    missing = [c for c in code if c[\"id\"] not in used]"},
    {"id": "C70", "text": "    assert not missing, \"these lines reach no idea: \" + \", \".join(f'{c[\"id\"]} {c[\"text\"].strip()}' for c in missing)"},
    {"text": ""},
    {"text": ""},
    {"id": "C71", "text": "def diff(old_code, old_ideas, code, ideas):"},
    {"id": "C72", "text": "    sm = difflib.SequenceMatcher(None, [c[\"text\"] for c in old_code], [c[\"text\"] for c in code])"},
    {"id": "C73", "text": "    idmap = {old_code[a + k][\"id\"]: code[b + k][\"id\"] for a, b, n in sm.get_matching_blocks() for k in range(n)}"},
    {"id": "C74", "text": "    old = {i[\"id\"]: i for i in old_ideas}"},
    {"id": "C75", "text": "    new = {i[\"id\"]: i for i in ideas}"},
    {"id": "C76", "text": "    moved = [{\"id\": k, \"from\": sorted({idmap.get(s, s) for s in old[k][\"source\"]}), \"to\": sorted(set(new[k][\"source\"]))}"},
    {"id": "C77", "text": "             for k in sorted(old.keys() & new.keys())"},
    {"id": "C78", "text": "             if {idmap.get(s, s) for s in old[k][\"source\"]} != set(new[k][\"source\"])]"},
    {"id": "C79", "text": "    return {"},
    {"id": "C80", "text": "        \"added\": sorted(new.keys() - old.keys()),"},
    {"id": "C81", "text": "        \"removed\": [old[k] for k in sorted(old.keys() - new.keys())],"},
    {"id": "C82", "text": "        \"moved\": moved,"},
    {"id": "C83", "text": "        \"reworded\": [{\"id\": k, \"from\": old[k][\"text\"], \"to\": new[k][\"text\"]}"},
    {"id": "C84", "text": "                     for k in sorted(old.keys() & new.keys())"},
    {"id": "C85", "text": "                     if old[k][\"text\"] != new[k][\"text\"]],"},
    {"id": "C86", "text": "    }"},
    {"text": ""},
    {"text": ""},
    {"id": "C87", "text": "def main():"},
    {"id": "C88", "text": "    path = Path(sys.argv[1])"},
    {"id": "C89", "text": "    rows, n = [], 0"},
    {"id": "C90", "text": "    for l in path.read_text(encoding=\"utf-8\").splitlines():"},
    {"id": "C91", "text": "        n += 1 if l.strip() else 0"},
    {"id": "C92", "text": "        rows.append({\"id\": f\"C{n}\", \"text\": l} if l.strip() else {\"text\": l})"},
    {"id": "C93", "text": "    code = [r for r in rows if \"id\" in r]"},
    {"id": "C94", "text": "    assert code, f\"{path.name} is empty\""},
    {"text": ""},
    {"id": "C95", "text": "    old_code = load(path.parent / \"code.json\", \"code\")"},
    {"id": "C96", "text": "    old_code = [c for c in old_code if \"id\" in c] if old_code else None"},
    {"id": "C97", "text": "    old_ideas = load(path.parent / \"ideas.json\", \"ideas\")"},
    {"id": "C98", "text": "    old = \"\""},
    {"id": "C99", "text": "    if old_ideas:"},
    {"id": "C100", "text": "        old = OLD_RULES.format(ideas=json.dumps([{\"id\": i[\"id\"], \"text\": i[\"text\"]} for i in old_ideas]))"},
    {"text": ""},
    {"id": "C101", "text": "    write_json(path.parent / \"code.json\", \"code\", rows)"},
    {"id": "C102", "text": "    print(f\"{len(code)} lines -> code.json\")"},
    {"text": ""},
    {"id": "C103", "text": "    print(\"ideas...\")"},
    {"id": "C104", "text": "    base = IDEAS_PROMPT.format(code=json.dumps(code), old=old)"},
    {"id": "C105", "text": "    note = \"\""},
    {"id": "C106", "text": "    for attempt in range(3):"},
    {"id": "C107", "text": "        ideas = ask(base + note)[\"ideas\"]"},
    {"id": "C108", "text": "        try:"},
    {"id": "C109", "text": "            check(code, ideas)"},
    {"id": "C110", "text": "            break"},
    {"id": "C111", "text": "        except AssertionError as e:"},
    {"id": "C112", "text": "            print(f\"retry {attempt + 1}: {e}\")"},
    {"id": "C113", "text": "            note = (f\"\\n\\nYour last answer:\\n{json.dumps({'ideas': ideas})}\\n\\n\""},
    {"id": "C114", "text": "                    f\"It broke a rule: {e}. Repair it and return the full corrected JSON.\")"},
    {"id": "C115", "text": "    else:"},
    {"id": "C116", "text": "        sys.exit(\"no valid ideas after 3 tries\")"},
    {"id": "C117", "text": "    write_json(path.parent / \"ideas.json\", \"ideas\", ideas)"},
    {"id": "C118", "text": "    print(f\"{len(ideas)} ideas -> ideas.json\")"},
    {"text": ""},
    {"id": "C119", "text": "    if old_code and old_ideas:"},
    {"id": "C120", "text": "        d = diff(old_code, old_ideas, code, ideas)"},
    {"id": "C121", "text": "        (path.parent / \"diff.json\").write_text(json.dumps(d, indent=2) + \"\\n\", encoding=\"utf-8\")"},
    {"id": "C122", "text": "        print(f'{len(d[\"added\"])} added, {len(d[\"removed\"])} removed, {len(d[\"moved\"])} moved -> diff.json')"},
    {"id": "C123", "text": "    elif (path.parent / \"diff.json\").exists():"},
    {"id": "C124", "text": "        (path.parent / \"diff.json\").unlink()"},
    {"text": ""},
    {"id": "C125", "text": "    v = snapshot(path.parent)"},
    {"id": "C126", "text": "    print(f\"version -> {v.relative_to(path.parent)}\")"},
    {"text": ""},
    {"text": ""},
    {"id": "C127", "text": "if __name__ == \"__main__\":"},
    {"id": "C128", "text": "    main()"}
  ]
}
