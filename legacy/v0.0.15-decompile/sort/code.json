{
  "code": [
    {"id": "C1", "text": "def insertion_sort(items):"},
    {"id": "C2", "text": "    for i in range(1, len(items)):"},
    {"id": "C3", "text": "        key = items[i]"},
    {"id": "C4", "text": "        j = i - 1"},
    {"id": "C5", "text": "        while j >= 0 and items[j] > key:"},
    {"id": "C6", "text": "            items[j + 1] = items[j]"},
    {"id": "C7", "text": "            j -= 1"},
    {"id": "C8", "text": "        items[j + 1] = key"},
    {"id": "C9", "text": "    return items"},
    {"text": ""},
    {"text": ""},
    {"id": "C10", "text": "print(insertion_sort([5, 2, 9, 1, 3]))"}
  ]
}
